[Unit]
Description=Brummer - Arenaspiel (Spielserver + Auslieferung)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brummer
Group=brummer
WorkingDirectory=/opt/brummer/server
Environment=NODE_ENV=production
Environment=PORT=4263
Environment=BIND_ADDRESS=127.0.0.1
Environment=DATA_DIR=/opt/brummer/data
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
UMask=0027

# Sandkasten
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/brummer/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
